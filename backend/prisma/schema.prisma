generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String   @unique
  email         String   @unique
  category      String
  course        String
  batch         String
  passwordHash  String
  emailVerified Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model PendingRegistration {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String   @unique
  email        String   @unique
  category     String
  course       String
  batch        String
  passwordHash String
  otpHash      String
  otpExpiry    DateTime
  createdAt    DateTime @default(now())
}

model OtpUsage {
  date  String @id
  count Int    @default(0)
}
